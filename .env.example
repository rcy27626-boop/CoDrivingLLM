# CoDrivingLLM LLM 配置模板
# 复制本文件为 .env 并根据你的环境修改

# LLM API Key
# - Ollama 本地：随便填（如 "ollama"）
# - 硅基流动云端：填 sk-xxx
LLM_API_KEY=ollama

# LLM API Base URL
# - Ollama 本地（默认）：http://localhost:11434/v1
# - 硅基流动云端：https://api.siliconflow.cn/v1
LLM_BASE_URL=http://localhost:11434/v1

# LLM 模型名
# - Ollama 本地：qwen2.5:32b / qwen2.5:14b-local / qwen:8b / gemma4:12b 等
# - 硅基流动云端：Qwen/Qwen2.5-7B-Instruct / deepseek-ai/DeepSeek-V3 等
LLM_MODEL=qwen2.5:32b